{
  "info": {
    "_postman_id": "0d7c649f-76ad-4dd6-9c7b-c9ed0a202626",
    "name": "Credora Full Stack API",
    "description": "Course evaluation collection for Credora. Run Health first, then Register or Login to capture a JWT for the protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "delinquencyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 \u00b7 Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health endpoint returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Service status is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 \u00b7 Authentication",
      "item": [
        {
          "name": "Register (edit email if it already exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration succeeds', function () { pm.response.to.have.status(201); });",
                  "const response = pm.response.json();",
                  "if (response.token) pm.collectionVariables.set('token', response.token);",
                  "pm.test('A token is returned', function () { pm.expect(response.token).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Evaluator\",\n  \"email\": \"credora.evaluator.{{$timestamp}}@example.com\",\n  \"password\": \"CredoraDemo123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login (use a registered email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "if (response.token) pm.collectionVariables.set('token', response.token);",
                  "pm.test('A token is returned', function () { pm.expect(response.token).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"evaluator@example.com\",\n  \"password\": \"CredoraDemo123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "03 \u00b7 Dashboard",
      "item": [
        {
          "name": "Get dashboard summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard summary returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Metrics are present', function () { pm.expect(pm.response.json()).to.have.property('metrics'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/dashboard/summary"
          }
        }
      ]
    },
    {
      "name": "04 \u00b7 Customers",
      "item": [
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/customers"
          }
        },
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer was created', function () { pm.response.to.have.status(201); });",
                  "const response = pm.response.json();",
                  "if (response.customer?._id) pm.collectionVariables.set('customerId', response.customer._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Riya Desai\",\n  \"email\": \"riya.desai.demo@example.com\",\n  \"phone\": \"+91 98765 43210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/customers"
          }
        },
        {
          "name": "Search customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/customers?search=Riya"
          }
        }
      ]
    },
    {
      "name": "05 \u00b7 Loans",
      "item": [
        {
          "name": "List loans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/loans"
          }
        },
        {
          "name": "Create loan (requires customerId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Loan was created', function () { pm.response.to.have.status(201); });",
                  "const response = pm.response.json();",
                  "if (response.loan?._id) pm.collectionVariables.set('loanId', response.loan._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"principalAmount\": 125000,\n  \"interestRate\": 10.5,\n  \"tenureMonths\": 24,\n  \"startDate\": \"2026-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/loans"
          }
        }
      ]
    },
    {
      "name": "06 \u00b7 Payments",
      "item": [
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/payments"
          }
        },
        {
          "name": "Record payment (requires loanId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment was recorded', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanId\": \"{{loanId}}\",\n  \"amountPaid\": 5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/payments"
          }
        }
      ]
    },
    {
      "name": "07 \u00b7 Delinquency",
      "item": [
        {
          "name": "List open risk records",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.records && response.records.length) pm.collectionVariables.set('delinquencyId', response.records[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/delinquency?status=OPEN"
          }
        },
        {
          "name": "Run delinquency audit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/delinquency/audit"
          }
        },
        {
          "name": "Resolve risk record (requires delinquencyId)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/delinquency/{{delinquencyId}}/resolve"
          }
        }
      ]
    }
  ]
}
